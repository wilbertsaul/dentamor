# ============================================================
# Dentamor (IziPay) - .env de PRODUCCION (CONTABO) - plantilla
# ============================================================
# Copiar a la RAIZ del repo como ".env" y editar los valores con el
# prefijo "EDITAR". Nunca subir el .env real a git.
#
# La APP_KEY se genera SOLA en el primer arranque del contenedor
# (entrypoint). Si no, en el servidor:
#   docker exec dentamor_app php artisan key:generate --force
# ============================================================

APP_NAME=Dentamor
APP_ENV=production
APP_KEY=                            # EDITAR: se genera en el servidor
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://dentamor.jemigra.com  # EDITAR si tu IP/dominio cambia

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de datos centralizada en Contabo.
# La app se conecta POR LA RED DOCKER usando el alias del contenedor
# mysql (jemigra_db), NO 127.0.0.1. El estado real en el VPS:
#   docker exec izipay_app getent hosts jemigra_db   -> resuelve
DB_CONNECTION=mysql
DB_HOST=jemigra_db
DB_PORT=3306
DB_DATABASE=dentamor
DB_USERNAME=dentamor
DB_PASSWORD=                         # EDITAR: la clave del usuario dentamor que creas en el mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dentamor@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# json.pe - clave API para beta. Se guarda tambien en la tabla companies
# (por eso no es necesario en .env si ya la pusiste en los ajustes).
JSONPE_API_KEY=
JSONPE_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"
